{
  "name": "causolve",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -n frontend,backend -c blue,green \"pnpm --filter frontend dev\" \"pnpm --filter @causolve/backend dev\"",
    "ai:dev": "uv run --locked --directory apps/ai uvicorn app.main:create_app --factory --reload --host 127.0.0.1 --port 8000",
    "ai:test": "uv run --locked --directory apps/ai pytest",
    "ai:lint": "uv run --locked --directory apps/ai ruff check .",
    "ai:format": "uv run --locked --directory apps/ai ruff format .",
    "ai:format:check": "uv run --locked --directory apps/ai ruff format --check .",
    "ai:smoke": "uv run --locked --directory apps/ai pytest tests/smoke/test_gemini_provider.py --run-external -s",
    "generate:manifest": "node packages/simulation-data/scripts/generate-manifest.mjs"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
