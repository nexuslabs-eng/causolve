{
  "name": "causolve",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp run -r --parallel dev",
    "lint": "vp run -r --parallel lint",
    "check": "vp check",
    "ai:dev": "uv run --locked --directory apps/ai uvicorn app.main:create_app --factory --reload --host 127.0.0.1 --port 8000",
    "ai:test": "uv run --locked --directory apps/ai pytest",
    "ai:lint": "uv run --locked --directory apps/ai ruff check .",
    "ai:format": "uv run --locked --directory apps/ai ruff format .",
    "ai:contracts": "pnpm --filter contracts exec tsc --noEmit && uv run --locked --directory apps/ai python -m scripts.export_contract_samples .venv/ai-contract-output.json && pnpm --filter contracts test:ai-contracts ../../apps/ai/.venv/ai-contract-output.json",
    "ai:check": "pnpm ai:lint && uv run --locked --directory apps/ai ruff format --check . && pnpm ai:test && pnpm ai:contracts",
    "ai:test:gemini": "uv run --locked --directory apps/ai pytest tests/smoke/test_gemini_provider.py --run-external -s",
    "ai:smoke": "uv run --locked --directory apps/ai pytest tests/smoke/test_live_investigation.py --run-external -s",
    "generate:manifest": "node packages/simulation-data/scripts/generate-manifest.mjs",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.4"
}
