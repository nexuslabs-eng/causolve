# Runtime mode: development, test or production
AI_APP_ENV=development

# Enable interactive API documentation during local development.
AI_DOCS_ENABLED=true

# Required only for Gemini provider use and the live smoke test
AI_GEMINI_API_KEY=
AI_GEMINI_MODEL=gemini-3.5-flash
AI_GEMINI_TIMEOUT_SECONDS=60

AI_INTERNAL_API_KEY=
AI_EXECUTION_TIMEOUT_SECONDS=120
AI_LOG_LEVEL=INFO
