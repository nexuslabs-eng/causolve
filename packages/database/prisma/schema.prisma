generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AuthProvider {
  PASSWORD
  GOOGLE
  GITHUB
}

enum Role {
  OBSERVER
  ENGINEER
  INCIDENT_COMMANDER
  ADMIN
}

enum JobRole {
  SOFTWARE_ENGINEER
  SITE_RELIABILITY_ENGINEER
  DEVOPS_PLATFORM_ENGINEER
  ENGINEERING_MANAGER
  INCIDENT_COMMANDER
  OTHER
}

enum TeamSize {
  ONE_TO_FIVE
  SIX_TO_TWENTY
  TWENTY_ONE_TO_FIFTY
  FIFTY_ONE_TO_TWO_HUNDRED
  TWO_HUNDRED_PLUS
}

enum PrimaryResponsibility {
  APPLICATION_ENGINEERING
  RELIABILITY_SRE
  PLATFORM_ENGINEERING
  INFRASTRUCTURE
  ENGINEERING_LEADERSHIP
  OTHER
}

enum ServiceHealthStatus {
  HEALTHY
  DEGRADED
  UNAVAILABLE
  UNKNOWN
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  DETECTED
  ACKNOWLEDGED
  INVESTIGATING
  MITIGATING
  MONITORING
  RESOLVED
}

enum ActorType {
  USER
  AI
  SYSTEM
}

enum InvestigationStatus {
  PENDING
  RUNNING
  COMPLETED
  DEGRADED
  FAILED
}

enum IntegrityLevel {
  HIGH
  MODERATE
  DEGRADED
  LOW
}

enum HypothesisStatus {
  CANDIDATE
  PLAUSIBLE
  LEADING
  WEAKENED
  INVALIDATED
  CONFIRMED
}

enum EvidenceSourceType {
  METRIC
  LOG
  TRACE
  DEPLOYMENT
  CHANGE
  RUNTIME_STATE
  ALERT
  TOPOLOGY
  INCIDENT_HISTORY
  RUNBOOK
  HUMAN_OBSERVATION
}

enum EvidenceRelationType {
  SUPPORTS
  CONTRADICTS
  NEUTRAL
}

enum ContradictionSeverity {
  WEAK
  MODERATE
  STRONG
  INVALIDATING
}

model User {
  id                        String                 @id @default(uuid())
  fullName                  String
  email                     String                 @unique
  passwordHash              String?
  authProvider              AuthProvider
  emailVerified             Boolean                @default(false)
  jobRole                   JobRole?
  primaryResponsibility     PrimaryResponsibility?
  onboardingCompletedAt     DateTime?
  verificationCode          String?
  verificationAttempts      Int                    @default(0)
  verificationCodeExpires   DateTime?
  passwordResetTokenHash    String?                @unique
  passwordResetTokenExpires DateTime?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  memberships               Membership[]
  sentInvitations           Invitation[]
  incidents                 Incident[]
}

// Matches connect-pg-simple's expected table exactly (sid/sess/expire),
// so express-session can use it as its store. Modeled here (rather than
// letting connect-pg-simple create it itself) so it's tracked by Prisma's
// own migration history instead of showing up as untracked drift later.
model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

model Organization {
  id               String       @id @default(uuid())
  name             String
  slug             String       @unique
  teamSize         TeamSize?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  incidentSequence Int          @default(0)
  memberships      Membership[]
  teams            Team[]
  services         Service[]
  invitations      Invitation[]
  incidents        Incident[]
}

model Membership {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  role           Role
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Team {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  services     Service[]

  @@unique([organizationId, name])
}

model Service {
  id             String              @id @default(uuid())
  organizationId String
  teamId         String?
  name           String
  environment    String
  healthStatus   ServiceHealthStatus @default(UNKNOWN)
  currentVersion String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team         Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)
  incidents    Incident[]

  @@unique([organizationId, name])
}

model Invitation {
  id             String           @id @default(uuid())
  organizationId String
  email          String
  role           Role
  inviteeJobRole JobRole?
  status         InvitationStatus @default(PENDING)
  tokenHash      String           @unique
  invitedById    String?
  createdAt      DateTime         @default(now())
  expiresAt      DateTime
  acceptedAt     DateTime?
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation(fields: [invitedById], references: [id], onDelete: SetNull)
}

model Incident {
  id             String           @id @default(uuid())
  reference      String           @unique
  organizationId String
  serviceId      String
  title          String
  description    String?
  severity       IncidentSeverity
  status         IncidentStatus   @default(DETECTED)
  commanderId    String?
  startedAt      DateTime         @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization  Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  service       Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  commander     User?           @relation(fields: [commanderId], references: [id], onDelete: SetNull)
  events        IncidentEvent[]
  investigation Investigation?
}

model IncidentEvent {
  id         String    @id @default(uuid())
  incidentId String
  actorType  ActorType
  actorId    String?
  type       String
  message    String
  metadata   Json?
  createdAt  DateTime  @default(now())

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId, createdAt])
}

model Investigation {
  id                  String              @id @default(uuid())
  incidentId          String              @unique //one investigation per incident, for now
  status              InvestigationStatus @default(PENDING)
  integrity           IntegrityLevel      @default(HIGH)
  evidenceCoverage    Float               @default(0)
  leadingHypothesisId String?
  startedAt           DateTime            @default(now())
  completedAt         DateTime?
  hypothesisSequence  Int                 @default(0)
  evidenceSequence    Int                 @default(0)

  incident   Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  hypotheses Hypothesis[]
  evidence   Evidence[]
}

model Hypothesis {
  id                        String           @id @default(uuid())
  reference                 String
  investigationId           String
  statement                 String
  status                    HypothesisStatus @default(CANDIDATE)
  supportStrength           Float            @default(0)
  contradictionPressure     Float            @default(0)
  independentEvidenceGroups Int              @default(0)
  unresolvedContradictions  Int              @default(0)
  rank                      Int
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt

  investigation Investigation                @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  evidenceLinks EvidenceHypothesisRelation[]

  @@unique([investigationId, reference])
}

model Evidence {
  id                String             @id @default(uuid())
  reference         String
  investigationId   String
  source            String
  sourceType        EvidenceSourceType
  observation       String
  reliability       Float
  specificity       Float
  directness        Float
  freshness         Float
  temporalRelevance Float
  independenceGroup String
  provenance        Json
  createdAt         DateTime           @default(now())

  investigation   Investigation                @relation(fields: [investigationId], references: [id], onDelete: Cascade)
  hypothesisLinks EvidenceHypothesisRelation[]

  @@unique([investigationId, reference])
}

model EvidenceHypothesisRelation {
  id                    String                 @id @default(uuid())
  evidenceId            String
  hypothesisId          String
  relation              EvidenceRelationType
  reasoning             String
  weight                Float?
  contradictionSeverity ContradictionSeverity?

  evidence   Evidence   @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  hypothesis Hypothesis @relation(fields: [hypothesisId], references: [id], onDelete: Cascade)

  @@unique([evidenceId, hypothesisId])
}
